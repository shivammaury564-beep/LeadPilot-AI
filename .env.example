# =============================================================================
# LeadPilot AI — Environment Variables Configuration
# =============================================================================

# 1. SUPABASE CONFIGURATION (Primary PostgreSQL Database & Authentication)
# Frontend public variables (safe for browser bundle; RLS enforced in PostgreSQL)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# Backend Supabase variables (used by server.ts auth middleware & RLS client)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
# WARNING: Never expose SUPABASE_SERVICE_ROLE_KEY to the frontend (no VITE_ prefix).
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# 2. SERVER-SIDE AUTH SESSION SECRET (Used for local/session HMAC token signing)
AUTH_TOKEN_SECRET="replace-with-32-byte-random-hex-secret"

# 3. GEMINI AI CONFIGURATION (Server-Side Only — Never expose to frontend)
# AI Studio automatically injects GEMINI_API_KEY at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 4. GOOGLE MAPS PLATFORM CONFIGURATION
# Server-side key for Places API (New) proxy (Text Search, Nearby Search, Place Details)
GOOGLE_MAPS_PLATFORM_KEY="MY_GOOGLE_MAPS_API_KEY"
# Browser key for @vis.gl/react-google-maps interactive map rendering (restrict by HTTP referrer)
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# 5. META GRAPH API CONFIGURATION (Optional — Server-Side Only)
# When omitted, LeadPilot AI operates in compliant manual public profile research mode.
META_GRAPH_ACCESS_TOKEN="MY_META_ACCESS_TOKEN"

# 6. APPLICATION HOST URL
APP_URL="http://localhost:3000"
